-- ====================================================================
-- SCRIPT: 01_data_cleaning.sql
-- PROJECT: Olist Brazilian E-Commerce Analysis
-- PURPOSE: Inspect, clean, replace missing values, and normalize data.
-- ====================================================================

-- --------------------------------------------------------------------
-- STEP 1: INITIAL INSPECTION & ROW COUNT VERIFICATION
-- --------------------------------------------------------------------
-- Check total row counts for all core tables to establish a baseline.
SELECT 'olist_orders_dataset' AS table_name, COUNT(*) AS total_rows FROM olist_orders_dataset
UNION ALL
SELECT 'olist_order_items_dataset', COUNT(*) FROM olist_order_items_dataset
UNION ALL
SELECT 'olist_customers_dataset', COUNT(*) FROM olist_customers_dataset
UNION ALL
SELECT 'olist_products_dataset', COUNT(*) FROM olist_products_dataset
UNION ALL
SELECT 'olist_order_payments_dataset', COUNT(*) FROM olist_order_payments_dataset
UNION ALL
SELECT 'olist_order_reviews_dataset', COUNT(*) FROM olist_order_reviews_dataset;


-- --------------------------------------------------------------------
-- STEP 2: ORDERS DATASET CLEANING & TIMESTAMP CONVERSION
-- --------------------------------------------------------------------
-- Inspect missing timestamp values in the orders table.
-- Note: NULLs in 'order_delivered_customer_date' are legitimate for canceled or shipped orders.
SELECT 
    order_status,
    COUNT(*) AS total_orders,
    SUM(CASE WHEN order_approved_at IS NULL THEN 1 ELSE 0 END) AS missing_approval_date,
    SUM(CASE WHEN order_delivered_carrier_date IS NULL THEN 1 ELSE 0 END) AS missing_carrier_date,
    SUM(CASE WHEN order_delivered_customer_date IS NULL THEN 1 ELSE 0 END) AS missing_delivery_date
FROM olist_orders_dataset
GROUP BY order_status
ORDER BY total_orders DESC;


-- --------------------------------------------------------------------
-- STEP 3: PRODUCTS DATASET - HANDLING MISSING CATEGORIES
-- --------------------------------------------------------------------
-- Check for NULL or blank product categories
SELECT COUNT(*) AS missing_category_count
FROM olist_products_dataset
WHERE product_category_name IS NULL OR product_category_name = '';

-- Fill missing product category values with 'unspecified'
UPDATE olist_products_dataset
SET product_category_name = 'unspecified'
WHERE product_category_name IS NULL OR product_category_name = '';


-- --------------------------------------------------------------------
-- STEP 4: GEOLOCATION DEDUPLICATION
-- --------------------------------------------------------------------
-- Issue: olist_geolocation_dataset contains multiple lat/long pairs for the same zip code.
-- Solution: Aggregate coordinates by zip code to create a clean 1-to-1 lookup table.

IF OBJECT_ID('dim_geolocation_clean', 'U') IS NOT NULL 
    DROP TABLE dim_geolocation_clean;

SELECT 
    geolocation_zip_code_prefix AS zip_code_prefix,
    AVG(geolocation_lat) AS latitude,
    AVG(geolocation_lng) AS longitude,
    UPPER(TRIM(MIN(geolocation_city))) AS city,
    UPPER(TRIM(MIN(geolocation_state))) AS state
INTO dim_geolocation_clean
FROM olist_geolocation_dataset
GROUP BY geolocation_zip_code_prefix;

-- Verify unique zip codes in the new lookup table
SELECT COUNT(DISTINCT zip_code_prefix) AS unique_zip_codes, COUNT(*) AS total_rows 
FROM dim_geolocation_clean;


-- --------------------------------------------------------------------
-- STEP 5: REVIEWS DATASET - TEXT & SCORE CLEANING
-- --------------------------------------------------------------------
-- Handle missing review title/comment message (replace NULL with empty placeholder)
UPDATE olist_order_reviews_dataset
SET review_comment_title = ISNULL(review_comment_title, 'No Title'),
    review_comment_message = ISNULL(review_comment_message, 'No Message');


-- --------------------------------------------------------------------
-- STEP 6: DATA INTEGRITY & ANOMALY CHECKS
-- --------------------------------------------------------------------
-- Check for negative or zero prices/freight costs
SELECT COUNT(*) AS invalid_price_rows
FROM olist_order_items_dataset
WHERE price <= 0 OR freight_value < 0;

-- Check for invalid payment values
SELECT COUNT(*) AS invalid_payment_rows
FROM olist_order_payments_dataset
WHERE payment_value <= 0;
